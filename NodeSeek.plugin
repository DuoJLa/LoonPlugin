#!name = NodeSeek 签到
#!desc = NodeSeek Cookie 捕获与每日自动签到（Egern 转换版）
#!author = Nullwhy / Loon conversion
#!homepage = https://github.com/Nullwhy/Egern
#!icon = https://raw.githubusercontent.com/Nullwhy/Egern/main/Icon/Nullwhy.png
#!loon_version = 3.5.1(983)
#!date = 2026-10-10
#!tag = NodeSeek,签到
#!type = normal

[Argument]
cron = input,"10 0 * * *",type=string,tag=签到时间,desc=五段Cron表达式，例如每天00:10
fixed_legs = switch,false,type=boolean,tag=固定鸡腿,desc=关闭为随机鸡腿，开启为固定5鸡腿
enable_capture = switch,false,type=boolean,tag=Cookie捕获,desc=开启后访问NodeSeek个人页保存请求头，成功后请关闭

[Script]
request if ${url} ~= /^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\// then script("https://raw.githubusercontent.com/DuoJLa/LoonPlugin/main/NodeSeek-Capture-v2.js", {${enable_capture}}) with enable=${enable_capture}, tag="NodeSeek Cookie v2", timeout=30
cron ${cron} then script("https://raw.githubusercontent.com/DuoJLa/LoonPlugin/main/NodeSeek-Loon.js?v=1.2.0", {${fixed_legs}}) with tag="NodeSeek 签到", timeout=60

[MitM]
hostname = www.nodeseek.com
