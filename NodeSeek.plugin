#!name = NodeSeek 签到
#!desc = NodeSeek Cookie 捕获与每日自动签到（Egern 转换版）
#!author = Nullwhy / Loon conversion
#!homepage = https://github.com/Nullwhy/Egern
#!icon = https://raw.githubusercontent.com/Nullwhy/Egern/main/Icon/Nullwhy.png
#!loon_version = 3.5.1(983)
#!date = 2026-10-10
#!tag = NodeSeek,签到
#!type = normal

[Argument]
minute = input,"00",type=string,tag=分钟,desc=定时签到分钟（00-59）
hour = input,"10",type=string,tag=小时,desc=定时签到小时（0-23）
fixed_legs = switch,false,type=boolean,tag=固定鸡腿,desc=关闭为随机鸡腿，开启为固定5鸡腿
enable_capture = switch,false,type=boolean,tag=Cookie捕获,desc=开启后访问NodeSeek个人页保存请求头，成功后请关闭

[Script]
request if ${url} ~= /^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\// then script("https://raw.githubusercontent.com/DuoJLa/LoonPlugin/main/NodeSeek-Loon.js?v=1.1.3", {${enable_capture}}) with enable=${enable_capture}, tag="NodeSeek Cookie", timeout=30
cron ${minute} ${hour} * * * then script("https://raw.githubusercontent.com/DuoJLa/LoonPlugin/main/NodeSeek-Loon.js", {${fixed_legs}}) with tag="NodeSeek 签到", timeout=60

[MitM]
hostname = www.nodeseek.com
